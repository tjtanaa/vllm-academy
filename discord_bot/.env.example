# Copy to discord_bot/.env and fill in. Never commit the real .env.

# Required: Bot token from https://discord.com/developers/applications → your app → Bot → Reset Token
DISCORD_TOKEN=

# Strongly recommended while testing: your server ID(s), comma-separated.
# Guild commands appear instantly; global commands can take up to an hour.
DISCORD_GUILD_IDS=

# Language for public posts and new users: zh (繁體中文) or en
ACADEMY_DEFAULT_LANG=zh
ACADEMY_TIMEZONE=Asia/Taipei
# Hour (0-23, local time) for the Daily Drop
ACADEMY_DAILY_HOUR=20

# Optional: fixed channels. /academy setup also configures these per server.
ACADEMY_DAILY_CHANNEL_ID=
ACADEMY_ANNOUNCE_CHANNEL_ID=

# Optional: a GitHub token (no scopes needed) raises the API rate limit for /gfi and the release radar
GITHUB_TOKEN=

# Links in embeds point here (change if you fork)
ACADEMY_REPO_URL=https://github.com/tjtanaa/vllm-academy
ACADEMY_REPO_BRANCH=main

ACADEMY_LEVEL_ROLES=true
ACADEMY_PUBLIC_LEVEL_UP=true
ACADEMY_RELEASE_RADAR=true
# ACADEMY_DB_PATH=/data/academy.sqlite3
